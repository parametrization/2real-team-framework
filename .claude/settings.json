{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/start_dispatcher.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/dispatcher.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/dispatcher.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/stop_dispatcher.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/post_dispatcher.py\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/assets/hooks/post_dispatcher.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(.claude/**)",
      "Read(.claude/**)",
      "Write(.claude/**)",
      "Bash(python3 .claude/hooks/*)",
      "Bash(python3 .claude/lib/*)",
      "Bash(mkdir -p .claude/*)",
      "Bash(ls .claude/*)",
      "Bash(cat .claude/*)",
      "Bash(cp .claude/*)",
      "Bash(mv .claude/*)"
    ]
  }
}

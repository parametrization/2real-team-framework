{
  "version": 1,
  "project": {
    "name": "2real-team-framework",
    "model": "single-repo"
  },
  "scm": {
    "provider": "github",
    "owner": "parametrization",
    "default_branch": "main",
    "allow_force": false
  },
  "shell": "zsh",
  "identity": {
    "enforce": true,
    "email_pattern": "{First}.{Last}@gmail.com",
    "roster_source": ".claude/team/roster.json",
    "allow_emails": ["parametrization@gmail.com"]
  },
  "policy": {
    "reviewers_required": 1,
    "pr_review_gate_enabled": false,
    "merge_model": "wave-branch"
  },
  "ci": {
    "merge_requires_green": true,
    "tooling": ["ruff", "pytest"]
  },
  "paths": {
    "ontology": "ontology"
  },
  "branch": {
    "integration": "deployments/phase{phase}/wave-{wave}"
  },
  "labels": {
    "wave": "phase{phase}-wave-{wave}"
  },
  "hooks": {
    "pre_bash": [
      "validate_commit_identity",
      "block_no_verify",
      "block_git_config",
      "no_worktree_self_delete",
      "warn_zsh_wordsplit",
      "validate_labels",
      "validate_review_comment_format",
      "block_gh_pr_review",
      "validate_workflow_paths_coverage",
      "require_load_bearing_test",
      "validate_pr_ci_status",
      "validate_pr_review",
      "block_squash_wave_merge"
    ],
    "post_bash": ["warn_pipe_mask_rc"],
    "post_file": ["ontology_tracker", "suggest_generic_prompt"],
    "session_start": ["ontology_refresh", "session_start"],
    "agent": [],
    "stop": ["session_handoff"]
  }
}
